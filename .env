# Healthcare SDN-IoT System Configuration
MQTT_BROKER_HOST=127.0.0.1
MQTT_BROKER_PORT=1883
MQTT_KEEPALIVE=60
MQTT_QOS=1

DATABASE_URL=sqlite:///db/healthcare.db

# Ryu Controller REST WSGI Configuration
RYU_REST_URL=http://127.0.0.1:8080
FLOW_HARD_TIMEOUT=60

# Flask Dashboard Configuration
FLASK_SECRET_KEY=dev-secret-key-healthcare-sdn-iot-2026
FLASK_PORT=5000
FLASK_DEBUG=False
ADMIN_USERNAME=admin
ADMIN_PASSWORD=admin123

# Replay & Inference Settings
REPLAY_SPEED=1.0
DEBOUNCE_WINDOWS=2
ECG_SAMPLING_RATE=360
